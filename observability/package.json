{
  "name": "deepseek-observability-reproducibility-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first, privacy-safe observability tests for a DeepSeek API integration.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "offline": "node --test tests/*.test.mjs && node source/offline-runner.mjs",
    "audit": "node source/audit-cli.mjs",
    "live": "node source/live-cli.mjs"
  }
}
